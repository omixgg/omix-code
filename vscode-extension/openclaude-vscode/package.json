{
  "name": "OmixCode-vscode",
  "displayName": "OmixCode",
  "description": "Practical VS Code companion for OmixCode with project-aware launch behavior and a real Control Center.",
  "version": "0.2.0",
  "publisher": "devnull-bootloader",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:OmixCode.start",
    "onCommand:OmixCode.startInWorkspaceRoot",
    "onCommand:OmixCode.openDocs",
    "onCommand:OmixCode.openSetupDocs",
    "onCommand:OmixCode.openWorkspaceProfile",
    "onCommand:OmixCode.openControlCenter",
    "onCommand:OmixCode.newChat",
    "onCommand:OmixCode.openChat",
    "onCommand:OmixCode.resumeSession",
    "onCommand:OmixCode.abortChat",
    "onView:OmixCode.controlCenter",
    "onView:OmixCode.chat"
  ],
  "main": "./src/extension.js",
  "files": [
    "README.md",
    "media/**",
    "src/extension.js",
    "src/presentation.js",
    "src/state.js",
    "src/chat/**",
    "themes/**"
  ],
  "contributes": {
    "commands": [
      {
        "command": "OmixCode.start",
        "title": "OmixCode: Launch in Terminal",
        "category": "OmixCode"
      },
      {
        "command": "OmixCode.startInWorkspaceRoot",
        "title": "OmixCode: Launch in Workspace Root",
        "category": "OmixCode"
      },
      {
        "command": "OmixCode.openDocs",
        "title": "OmixCode: Open Repository",
        "category": "OmixCode"
      },
      {
        "command": "OmixCode.openSetupDocs",
        "title": "OmixCode: Open Setup Guide",
        "category": "OmixCode"
      },
      {
        "command": "OmixCode.openWorkspaceProfile",
        "title": "OmixCode: Open Workspace Profile",
        "category": "OmixCode"
      },
      {
        "command": "OmixCode.openControlCenter",
        "title": "OmixCode: Open Control Center",
        "category": "OmixCode"
      },
      {
        "command": "OmixCode.newChat",
        "title": "OmixCode: New Chat",
        "category": "OmixCode"
      },
      {
        "command": "OmixCode.openChat",
        "title": "OmixCode: Open Chat Panel",
        "category": "OmixCode"
      },
      {
        "command": "OmixCode.resumeSession",
        "title": "OmixCode: Resume Session",
        "category": "OmixCode"
      },
      {
        "command": "OmixCode.abortChat",
        "title": "OmixCode: Abort Generation",
        "category": "OmixCode"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "OmixCode",
          "title": "OmixCode",
          "icon": "media/OmixCode.svg"
        }
      ]
    },
    "views": {
      "OmixCode": [
        {
          "id": "OmixCode.chat",
          "name": "Chat",
          "type": "webview"
        },
        {
          "id": "OmixCode.controlCenter",
          "name": "Control Center",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "OmixCode.openChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      }
    ],
    "configuration": {
      "title": "OmixCode",
      "properties": {
        "OmixCode.launchCommand": {
          "type": "string",
          "default": "OmixCode",
          "description": "Command run in the integrated terminal when launching OmixCode."
        },
        "OmixCode.terminalName": {
          "type": "string",
          "default": "OmixCode",
          "description": "Integrated terminal tab name for OmixCode sessions."
        },
        "OmixCode.useOpenAIShim": {
          "type": "boolean",
          "default": false,
          "description": "Optionally set CLAUDE_CODE_USE_OPENAI=1 in launched OmixCode terminals."
        },
        "OmixCode.permissionMode": {
          "type": "string",
          "default": "acceptEdits",
          "enum": ["default", "acceptEdits", "bypassPermissions", "plan"],
          "enumDescriptions": [
            "Prompt for permission on each tool use (requires manual approval)",
            "Auto-approve file edits, prompt for other operations (recommended)",
            "Auto-approve all operations without prompting",
            "Read-only mode — no file modifications allowed"
          ],
          "description": "Permission mode for chat sessions. Controls which tool operations are auto-approved."
        }
      }
    },
    "themes": [
      {
        "label": "OmixCode Terminal Black",
        "uiTheme": "vs-dark",
        "path": "./themes/OmixCode-Terminal-Black.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test ./src/*.test.js",
    "lint": "node scripts/lint.js",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "keywords": [
    "OmixCode",
    "terminal",
    "theme",
    "cli",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/omixgg/OmixCode"
  },
  "license": "MIT"
}
